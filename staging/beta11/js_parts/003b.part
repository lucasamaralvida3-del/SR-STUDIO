function splitHeaderRows(rows){let best=0,score=-1;for(let i=0;i<Math.min(rows.length,20);i++){const vals=(rows[i]||[]).map(norm);let s=0;for(const v of vals){if(/EAN|CODIGO|COD\b|PRODUTO|DESCRICAO|ITEM|PROMOCAO|PRECO|VENDA|LIMITE|ENTRADA/.test(v))s+=2;if(v)s+=.05}if(s>score){score=s;best=i}}return best}
function rowsFromSheet(ws){const matrix=XLSX.utils.sheet_to_json(ws,{header:1,defval:''});if(!matrix.length)return[];const hi=splitHeaderRows(matrix),heads=matrix[hi].map(x=>String(x||'').trim());return matrix.slice(hi+1).filter(r=>r.some(x=>String(x||'').trim())).map(r=>{const o={};heads.forEach((h,i)=>{if(h)o[h]=r[i]??''});return o})}
function pick(row,names){const m={};Object.keys(row||{}).forEach(k=>m[norm(k)]=row[k]);for(const n of names){const v=m[norm(n)];if(v!==undefined&&v!==null&&String(v).trim()!=='')return v}return''}
function detectUnit(row){let u=pick(row,['UNIDADE','UN','UND','UN VENDA']);if(u)return norm(u).slice(0,6);const e=pick(row,['ENTRADA']);if(typeof e==='string'){const x=norm(e);if(x.includes('KG'))return'KG';if(x.includes('UN'))return'UN'}if(typeof e==='number'&&!Number.isInteger(e))return'KG';return''}
function rowProduct(row){const name=pick(row,['PRODUTO','PRODUTOS','NOME','DESCRICAO','DESCRIÇÃO','ITEM','DESCRICAO PRODUTO']);const code=pick(row,['EAN','CODIGO','CÓDIGO','COD','COD BARRAS','CODIGO DE BARRAS']);const price=pick(row,['PRECO PROMOCAO','PREÇO PROMOÇÃO','PROMOCAO','PROMOÇÃO','PRECO','PREÇO','VAREJO']);const app=pick(row,['PRECO APP','PREÇO APP','APP','CLUBE','