n-items:center;cursor:grab}.sr11-prod.used{opacity:.58}.sr11-prod:hover{border-color:#8bb2ef}.sr11-prod .pn{font-size:12px;font-weight:900;line-height:1.18}.sr11-prod .pm{font-size:10px;color:#6c7b90;margin-top:3px}.sr11-prod .cat{display:inline-block;background:#eef4ff;color:#24559b;border-radius:999px;padding:2px 6px;margin-top:4px;font-size:9px;font-weight:850}.sr11-prod button{width:31px;height:31px;border:0;border-radius:8px;background:#e8f1ff;color:#0d47a1;font-weight:950;cursor:pointer}
.sr11-center{min-height:0;overflow:auto;padding:32px;display:flex;justify-content:center;align-items:flex-start;background:linear-gradient(45deg,#e4eaf1 25%,transparent 25%),linear-gradient(-45deg,#e4eaf1 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#e4eaf1 75%),linear-gradient(-45deg,transparent 75%,#e4eaf1 75%);background-size:22px 22px;background-position:0 0,0 11px,11px -11px,-11px 0}.sr11-zoom{transform-origin:top center}.sr11-page{position:relative;background:#fff;box-shadow:0 18px 48px #17203335;overflow:hidden}.sr11-page.grid:after{content:'';position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(#0000000b 1px,transparent 1px),linear-gradient(90deg,#0000000b 1px,transparent 1px);background-size:10px 10px;z-index:9999}
.tpl-text,.tpl-img,.tpl-shape,.slot-field,.prod-card,.slot-outline{position:absolute}.tpl-text{white-space:pre-wrap;overflow:hidden;display:flex}.tpl-img{object-fit:contain}.tpl-placeholder{opacity:.32}.prod-card{border:2px solid transparent;border-radius:14px;background:#fff;box-shadow:0 5px 18px #0002;overflow:hidden;display:grid;grid-template-rows:1fr auto;user-select:none;resize:both;min-width:130px;min-height:150px;z-index:500}.prod-card.selected{border-color:#1976d2;box-shadow:0 0 0 3px #1976d233,0 8px 24px #0002}.prod-card.highlight1{box-shadow:0 0 0 3px #ffb30055,0 8px 26px #0003}.prod-card.highlight2{box-shadow:0 0 0 5px #ff8f0055,0 10px 34px #0004}.prod-img{position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#f7f9fc}.prod-img img{max-width:94%;max-height:94%;object-fit:contain}.missing-img{font-size:10px;font-weight:900;color:#a15b00;text-align:center;padding:10px}.badge{position:absolute;top:7px;left:7px;background:#0d47a1;color:#fff;border-radius:999px;padding:4px 7px;font-size:9px;font-weight:900}.highlight1 .badge,.highlight2 .badge{background:#ef6c00}.prod-body{padding:8px 10px 10px}.prod-name{font-size:14px;font-weight:950;line-height:1.1;min-height:30px}.price-line{display:flex;align-items:flex-start;gap:2px;margin-top:4px}.price-rs{font-size:12px;font-weight:950;margin-top:17px}.price-real{font-size:42px;font-weight:1000;letter-spacing:-2px;line-height:.9}.price-cents{font-size:24px;font-weight:1000;line-height:1;margin-top:2px}.price-unit{font-size:11px;font-weight:950;margin-top:24px}.app-price{font-size:10px;font-weight:900;color:#0d47a1;margin-top:4px}.limit{font-size:9px;font-weight:900;color:#8b1b1b;margin-top:3px}.slot-field{z-index:520;overflow:hidden}.slot-field.text{display:flex;align-items:center}.slot-field.image{object-fit:contain}.slot-outline{z-index:540;border:2px dashed transparent;pointer-events:auto}.slot-outline:hover{border-color:#1976d266}.slot-outline.selected{border-color:#1976d2;background:#1976d208}.slot-empty{position:absolute;z-index:510;border:1.5px dashed #3b82f666;background:#eff6ff33;color:#3b82f6;font-size:9px;font-weight:900;display:flex;align-items:center;justify-content:center;text-align: