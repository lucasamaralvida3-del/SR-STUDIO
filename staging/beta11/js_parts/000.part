(() => {
'use strict';
const VERSION='4.0.10 • Beta 11';
const STORE='srstudio_encartes_beta11_project_v1';
const HISTORY=60;
const root=document.getElementById('sr11-root');
const uid=(p='id')=>`${p}_${Date.now().toString(36)}_${Math.random().toString(36).slice(2,8)}`;
const clone=o=>JSON.parse(JSON.stringify(o));
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
const norm=s=>String(s??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toUpperCase();
const fmtMoney=v=>{if(v===null||v===undefined||v==='')return '';let s=String(v).trim().replace(/\s/g,'');if(/^-?\d{1,3}(\.\d{3})+,\d{1,2}$/.test(s))s=s.replace(/\./g,'').replace(',','.');else if(/^-?\d+,\d{1,2}$/.test(s))s=s.replace(',','.');const n=Number(s.replace(/[^0-9.-]/g,''));return Number.isFinite(n)?n.toFixed(2).replace('.',','):String(v)};
const priceParts=v=>{const s=fmtMoney(v)||'--,--',a=s.split(',');return {reais:a[0]||'--',centavos:','+(a[1]||'00').padEnd(2,'0').slice(0,2)}};
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const newPage=(name='Página')=>({id:uid('pg'),name,width:794,height:1123,elements:[],templateElements:[],templateSlots:[],category:''});
let state={products:[],pages:[newPage('Página 1')],pageIndex:0,selected:null,grid:true,snap:true,zoom:.75,categoryFilter:'TODAS',fonts:[],projectName:'Novo Encarte'};
let past=[],future=[],saveTimer=0,issues=[];

const css=`
*{box-sizing:border-box}html,body,#sr11-root{width:100%;height:100%;overflow:hidden;font-family:Inter,Segoe UI,Arial,sans-serif;color:#172033;background:#eef2f7}button,input,select{font:inherit}
.sr11-app{height:100%;display:grid;grid-template-rows:58px 1fr 54px}.sr11-top{display:flex;align-items:center;gap:7px;padding:8px 12px;background:#0f1e38;color:#fff;box-shadow:0 2px 12px #0003;z-index:5}.sr11-brand{font-size:14px;font-weight:950;white-space:nowrap}.sr11-ver{font-size:10px;font-weight:900;background:#ffffff18;border:1px solid #ffffff22;padding:5px 8px;border-radius:999px;white-space:nowrap}.sr11-spacer{flex:1}.sr11-top button,.sr11-top select{height:35px;border:1px solid #ffffff2d;background:#ffffff10;color:#fff;border-radius:8px;padding:0 10px;font-weight:800;cursor:pointer}.sr11-top button:hover{background:#ffffff20}.sr11-top select option{color:#111}.sr11-top .primary{background:#1769d2;border-color:#1769d2}.sr11-status{font-size:10px;font-weight:800;color:#dce8ff;max-width:230px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sr11-main{min-height:0;display:grid;grid-template-columns:300px minmax(520px,1fr) 300px}.sr11-side{min-height:0;overflow:auto;background:#fff;padding:12px;border-right:1px solid #dbe2ec}.sr11-side.right{border-right:0;border-left:1px solid #dbe2ec}.sr11-title{font-size:11px;font-weight:950;letter-spacing:.08em;text-transform:uppercase;color:#66758b;margin:7px 0}.sr11-row{display:flex;gap:6px}.sr11-row>*{min-width:0;flex:1}.sr11-input{width:100%;height:36px;border:1px solid #cbd5e1;border-radius:8px;padding:0 9px;background:#fff;margin-bottom:7px}.sr11-btn{border:1px solid #d6deea;background:#f7f9fc;border-radius:8px;padding:8px 9px;font-weight:850;cursor:pointer}.sr11-btn:hover{background:#edf3fb}.sr11-btn.danger{color:#a11;background:#fff5f5;border-color:#f0caca}.sr11-file{display:none}
.sr11-products{display:flex;flex-direction:column;gap:7px}.sr11-prod{border:1px solid #dce3ec;border-radius:10px;padding:8px;background:#fff;display:grid;grid-template-columns:1fr auto;gap:6px;alig