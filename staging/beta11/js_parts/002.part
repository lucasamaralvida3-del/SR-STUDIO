center;pointer-events:none}
.sr11-pages{display:flex;gap:7px;align-items:center;padding:7px 12px;background:#fff;border-top:1px solid #dbe2ec;overflow:auto}.page-tab{height:37px;min-width:100px;border:1px solid #d7e0ea;background:#f8fafc;border-radius:8px;padding:0 10px;font-weight:800;cursor:pointer;white-space:nowrap}.page-tab.active{background:#e8f1ff;color:#0d47a1;border-color:#8bb2ef}.page-add{height:37px;border:1px solid #d7e0ea;border-radius:8px;background:#fff;font-weight:950;cursor:pointer}.page-meta{margin-left:auto;color:#6d7c90;font-size:10px;font-weight:800;white-space:nowrap}
.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}.kpi{border:1px solid #e0e6ee;background:#f8fafc;border-radius:8px;padding:7px;text-align:center}.kpi b{display:block;font-size:17px}.kpi span{font-size:8px;color:#6b7890;font-weight:850;text-transform:uppercase}.prop label{display:block;font-size:9px;font-weight:900;color:#64748b;text-transform:uppercase;margin:7px 0 3px}.help{font-size:10px;line-height:1.35;color:#6b7890;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:8px;margin-top:8px}.issue-list{display:flex;flex-direction:column;gap:5px;margin-top:8px}.issue{border-radius:7px;padding:7px;font-size:10px;font-weight:750}.issue.error{background:#fff1f1;color:#9b1c1c}.issue.warn{background:#fff9e7;color:#8a5a00}.issue.ok{background:#eefbf2;color:#176b32}.modal-bg{position:fixed;inset:0;background:#0007;z-index:999999;display:flex;align-items:center;justify-content:center}.modal{width:min(760px,92vw);max-height:82vh;overflow:auto;background:#fff;border-radius:14px;padding:18px;box-shadow:0 25px 80px #0006}.modal h2{margin:0 0 10px}.modal-actions{display:flex;justify-content:flex-end;gap:7px;margin-top:12px}.toast{position:fixed;left:50%;bottom:70px;transform:translateX(-50%);z-index:1000000;background:#172033;color:#fff;border-radius:9px;padding:10px 14px;font-size:11px;font-weight:850;opacity:0;pointer-events:none;transition:.2s}.toast.show{opacity:1}.font-list{display:flex;flex-wrap:wrap;gap:5px}.font-pill{padding:5px 7px;background:#eef4ff;border-radius:999px;font-size:9px;font-weight:800;color:#275895}
@media(max-width:1150px){.sr11-main{grid-template-columns:250px minmax(480px,1fr) 250px}.sr11-status{display:none}}
`;
const style=document.createElement('style');style.textContent=css;document.head.appendChild(style);
root.innerHTML=`<div class="sr11-app">
<div class="sr11-top"><div class="sr11-brand">SR STUDIO · ENCARTES</div><div class="sr11-ver">${VERSION}</div>
<button data-a="sheet">Planilha</button><input id="sheetFile" class="sr11-file" type="file" accept=".xlsx,.xls,.csv,.txt">
<button data-a="pptx">PPTX Canva</button><input id="pptxFile" class="sr11-file" type="file" accept=".pptx">
<button data-a="fonts">Fontes</button><input id="fontFile" class="sr11-file" type="file" accept=".ttf,.otf,.woff,.woff2" multiple>
<button data-a="undo">↶</button><button data-a="redo">↷</button><button data-a="auto">Layout automático</button><button data-a="validate">Validar</button>
<span class="sr11-spacer"></span><span id="status" class="sr11-status">LOCAL FIRST</span><select id="zoom"><option value="0.55">55%</option><option value="0.65">65%</option><option value="0.75" selected>75%</option><option value="0.9">90%</option><option value="1">100%</option></select><button class="primary" data-a="print">PDF / Imprimir</button></div>
<div class="sr11-main"><aside class="sr11-side"><div class="sr11-title">Produtos</div><div cla